{
  "name": "slimline",
  "version": "0.1.0",
  "description": "Claude Code PostToolUse hook that truncates oversized tool output (signal-aware: preserves error/failure lines) to save subscription quota, with a local retrievable cache of the original.",
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/hook.js",
  "bin": {
    "slimline": "dist/cli.js"
  },
  "files": [
    "dist/**/*.js",
    "!dist/**/*.test.js",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "claude",
    "claude-code",
    "hook",
    "posttooluse",
    "tokens",
    "quota",
    "context-window",
    "truncation"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node scripts/run-tests.js",
    "stats": "node dist/stats.js",
    "audit": "node dist/audit.js",
    "doctor": "node dist/cli.js doctor",
    "smoke": "node scripts/ci-smoke.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^20.0.0"
  }
}
